function gpm {
	if [ -z "$1" ]; then
    echo "You must provide one arguments!"
    echo "usage: gpm 'comment'"
    #git add -A . && git commit -m "$1" && git push
	else
    current_branch=$(git branch --show-current)
    git commit -m "$1" && git push origin $current_branch
	fi
}
function cpr {
  current_branch=$(git rev-parse --abbrev-ref HEAD)
  message=$1
  branch=$2
  git checkout -b $branch && gpm $message $branch && hub pull-request -m $message -b $current_branch
}
function merge_main {
  git checkout main
  git pull
  git checkout -
  git merge main
}

