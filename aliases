# Example usage: dd-files 898546818973.dkr.ecr.us-east-1.amazonaws.com/python-rclone:3.10 898546818973.dkr.ecr.us-east-1.amazonaws.com/python-rclone:3.10.8-bullseye-20240528
function dd-files() {
        FILENAME_1="files.${${1#*\/*}/:/"."}.txt"
        FILENAME_2="files.${${2#*\/*}/:/"."}.txt"

        echo "Generating file list for ${1} to ${FILENAME_1}..."
        docker run --user 0:0 --entrypoint /bin/sh -it $1 -c 'find / -type f -not \( -path "/proc/*" -or -path "/sys/*" -or -path "/boot/*" -or -path "/dev" -or -path "/mnt" -or -path "/run" \) -exec md5sum {} + | sort -k 2' > "${FILENAME_1}"

        echo "Generating file list for ${2} to ${FILENAME_2}..."
        docker run --user 0:0 --entrypoint /bin/sh -it $2 -c 'find / -type f -not \( -path "/proc/*" -or -path "/sys/*" \) -exec md5sum {} + | sort -k 2' > "${FILENAME_2}"
}

# Example usage: dd-files 898546818973.dkr.ecr.us-east-1.amazonaws.com/python-rclone:3.10 898546818973.dkr.ecr.us-east-1.amazonaws.com/python-rclone:3.10.8-bullseye-20240528
function dd-packages() {
        FILENAME_1="packages.${${1#*\/*}/:/"."}.txt"
        FILENAME_2="packages.${${2#*\/*}/:/"."}.txt"

        echo "Generating file list for ${1} to ${FILENAME_1}..."
        docker run --user 0:0 --entrypoint /bin/sh -it $1 -c  'pip freeze' > "${FILENAME_1}"

        echo "Generating file list for ${2} to ${FILENAME_2}..."
        docker run --user 0:0 --entrypoint /bin/sh -it $2 -c  'pip freeze' > "${FILENAME_2}"
}
